# Anthropic API Key — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Vercel KV (Redis) — created automatically when you add KV storage in Vercel dashboard
# Copy these from your Vercel project → Storage → KV → .env.local tab
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# Secret used to protect the cron endpoint (make up any random string)
CRON_SECRET=your-random-secret-here
